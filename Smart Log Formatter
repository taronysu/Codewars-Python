def smart_log_formatter(logs):
    if not logs:
        return []

    compressed_logs = []
    count = 1

    for i in range(1, len(logs)):
        if logs[i] == logs[i - 1]:
            count += 1
        else:
            if count > 1:
                compressed_logs.append(f"{logs[i - 1]} (x{count})")
            else:
                compressed_logs.append(logs[i - 1])
            count = 1

    if count > 1:
        compressed_logs.append(f"{logs[-1]} (x{count})")
    else:
        compressed_logs.append(logs[-1])

    return compressed_logs
