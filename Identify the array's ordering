def order_type(arr):
    inc = 1
    dec = 2
    length = lambda x: len(x) if isinstance(x, (str, list, dict)) else len(str(x))
    
    for i in range(1, len(arr)):
        diff = length(arr[i - 1]) - length(arr[i])
        if diff < 0:
            dec = 0
        if diff > 0:
            inc = 0
            
    return ["Unsorted", "Increasing", "Decreasing", "Constant"][inc + dec]
