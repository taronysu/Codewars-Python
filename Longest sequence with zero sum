def max_zero_sequence(arr):
    sum_map = {}
    max_length = 0
    end_index = -1
    current_sum = 0

    for i in range(len(arr)):
        current_sum += arr[i]

        if current_sum == 0:
            max_length = i + 1
            end_index = i

        if current_sum in sum_map:
            if i - sum_map[current_sum] > max_length:
                max_length = i - sum_map[current_sum]
                end_index = i
        else:
            sum_map[current_sum] = i

    if end_index == -1:
        return []

    return arr[end_index - max_length + 1:end_index + 1]
