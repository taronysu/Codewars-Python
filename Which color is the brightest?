def brightest(colors):
    col_ind = 0
    max_val = 0
    for i in range(len(colors)):
        color = colors[i]
        r = int(color[1:3], 16)
        g = int(color[3:5], 16)
        b = int(color[5:7], 16)
        value = max(r, g, b)
        if value > max_val:
            max_val = value
            col_ind = i
    return colors[col_ind]
