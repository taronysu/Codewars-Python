dictionary = {
    0: 'sıfır',
    1: 'bir',
    2: 'iki',
    3: 'üç',
    4: 'dört',
    5: 'beş',
    6: 'altı',
    7: 'yedi',
    8: 'sekiz',
    9: 'dokuz',
    10: 'on',
    20: 'yirmi',
    30: 'otuz',
    40: 'kırk',
    50: 'elli',
    60: 'altmış',
    70: 'yetmiş',
    80: 'seksen',
    90: 'doksan',
}

def get_turkish_number(num):
    if not (0 <= num <= 99):
        raise ValueError('Please give a number between 0 and 100.')

    if num in dictionary:
        return dictionary[num]

    digits = list(str(num))

    return ' '.join(dictionary[int(digit) * 10 ** (len(digits) - 1 - index)] for index, digit in enumerate(digits))
