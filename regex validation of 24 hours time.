import re
def validate_time(time):
    regex = "^([01]?[0-9]|2[0-3]):[0-5][0-9]$"
    t = re.compile(regex)
    if (time == "") :
        return False;
    m = re.search(t, time)
    if m is None :
        return False
    else :
        return True
